# Template for keystore.properties (not versioned), which app/build.gradle.kts
# reads to sign the release. Without it the release APK comes out unsigned.
#
# The easy way is `make.bat keystore`: it creates the key in
# keystore/pp-coach-tracker-release.jks (not versioned either) and writes
# keystore.properties, asking for the password without echo.
#
# By hand, from android_native/:
#   keytool -genkeypair -keystore keystore/pp-coach-tracker-release.jks -storetype PKCS12 ^
#     -alias ppcoachtracker -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=pp-coach-tracker, C=MX"
# then copy this file to keystore.properties and fill in the password.
#
# Back up the .jks and the password outside the repo: Android identifies the
# app by its signature, so a lost key means no more updates for this app.

storeFile=keystore/pp-coach-tracker-release.jks
storePassword=CHANGE_ME
keyAlias=ppcoachtracker
keyPassword=CHANGE_ME
