# pp-coach-tracker: variables de entorno
#
# Copia este archivo a .env (no se versiona) y llena los valores.
# Nunca pongas secretos reales aquí: este archivo sí se versiona.

# ---------------------------------------------------------------------------
# Meta Model API (worker)
# ---------------------------------------------------------------------------
# Sin MODEL_API_KEY el worker no arranca. Se crea en el dashboard → API keys.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# URL para SAM. Vacía = META_API_BASE_URL (demo y producción).
# En desarrollo, el simulador local: http://sam-sim:8090/v1
SAM_API_BASE_URL=
SAM_MODEL=sam-3.1
MUSE_SPARK_MODEL=muse-spark-1.3
# Límite de cuadros por trabajo: un clip que lo pase falla antes de gastar créditos.
META_MAX_FRAMES_PER_JOB=15000
# Caché de respuestas crudas de Meta (no es respaldo: solo evita pagar dos veces).
META_CACHE_DIR=worker/.local/meta_cache

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Local con docker-compose: http://php/pp-coach-tracker
# Producción (Modal o VPS): https://ppcoachtracker.pepemxl.com
PP_COACH_TRACKER_API_URL=http://localhost/pp-coach-tracker
POLL_SECONDS=10
WORK_DIR=worker/.local/jobs
# SAM busca las líneas de la cancha en cuadros clave (apagado por omisión: 0 o 1).
PP_PITCH_SAM=0
# Concepto de SAM para las líneas; los trazos del entrenador van como ejemplos.
SAM_LINE_CONCEPT=white line

# ---------------------------------------------------------------------------
# Desarrollo: simulador de SAM 3.1 (docs/13-entorno-desarrollo.md)
# ---------------------------------------------------------------------------
# Carpeta del prototipo donde vive el simulador (fuera de este repo; solo en
# esta máquina). Nunca se despliega.
PP_DEV_SAM_SIM_DIR=
SIM_PORT=8090
# 1 = sin mosaicos (más rápido); 2 = mosaicos 2x2 (más jugadores lejanos, ~3x más lento)
SIM_DETECTOR_LOCAL_TILES=1
# Fracción de llamadas que fallan a propósito con 429/500 (0 a 1)
SIM_FAIL_RATE=0
# 1 = corta el stream a la mitad una de cada cinco veces
SIM_CUT_STREAM=0
# 1 = el simulador también responde por Muse Spark (sin key: apunta
# META_API_BASE_URL al simulador y usa MODEL_API_KEY=sim-local)
SIM_MUSE=0

# ---------------------------------------------------------------------------
# API (Node en desarrollo, PHP en producción)
# ---------------------------------------------------------------------------
# Al menos 32 caracteres; la API no arranca sin él. Mismo valor en Node y PHP
# para que los JWT sirvan en las dos.
JWT_SECRET=
# Bearer que el worker manda en /internal/*. Mismo valor en la API y el worker.
WORKER_CALLBACK_SECRET=
# Tokens fijos para scripts y pruebas: "coach_id:token,coach_id:token".
API_TOKENS=
# mysql | memory
REPO=memory
HOST=127.0.0.1
PORT=3000
STORAGE_DIR=api/storage
# Subida de chunks en partes (docs/12-videos-largos-chunks.md):
# 8 MB por parte, 160 MB por chunk armado (5 min a 1080p ~112 MB)
MAX_PART_BYTES=8388608
MAX_CHUNK_BYTES=167772160
# 1 en producción: rechaza resultados que no sean de SAM real (sam_simulator)
PP_COACH_TRACKER_REQUIRE_META=0

# MySQL local (docker-compose de api/: MySQL 8 en 127.0.0.1:13306)
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=ppcoachtracker
DB_USER=ppcoachtracker
DB_PASSWORD=
# 1 para correr las pruebas de la API Node contra MySQL.
TEST_MYSQL=0

# API PHP
# Ruta de la app fuera de la carpeta web (la escribe el instalador en root.php).
PP_COACH_TRACKER_ROOT=
# 1 solo en local, sin TLS. En producción se deja vacío.
PP_COACH_TRACKER_ALLOW_HTTP=
# Contraseña para bin/user.php (si falta, la pide en la terminal).
PP_COACH_TRACKER_PASSWORD=

# ---------------------------------------------------------------------------
# Producción en Cloud Provider (las lee tools/package.sh para generar el .env del
# servidor en la primera instalación; nunca se imprimen)
# ---------------------------------------------------------------------------
# Base NUEVA con el prefijo de la cuenta: <prefijo>_ppcoachtracker
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=3306
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_JWT_SECRET=
PROD_WORKER_CALLBACK_SECRET=
